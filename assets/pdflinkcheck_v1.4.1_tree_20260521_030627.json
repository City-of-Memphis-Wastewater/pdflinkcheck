    "subcommands": [
        {
            "name": "analyze",
            "help": "Analyzes the specified PDF file for all internal, external, and unlinked references.\n\nChecks:\n\u2022 Internal GoTo links point to valid pages\n\u2022 Remote GoToR links point to existing files\n\u2022 TOC bookmarks target valid pages\n\nValidates:\n\u2022 Are referenced files available?\n\u2022 Are the page numbers referenced by GoTo links within the length of the document?",
            "kind": "command",
            "is_group": false,
            "parameters": [
                {
                    "name": "pdf_path",
                    "opts": [
                        "pdf_path"
                    ],
                    "secondary_opts": [],
                    "type": "<typer.models.TyperPath object at 0x7137e55e50>",
                    "required": false,
                    "default": null,
                    "help": "Path to the PDF file to analyze. If omitted, searches current directory.",
                    "hidden": false,
                    "is_flag": false,
                    "envvar": null
                },
                {
                    "name": "export_format",
                    "opts": [
                        "--format",
                        "-f"
                    ],
                    "secondary_opts": [],
                    "type": "Choice(['none', 'json', 'txt', 'xlsx', 'all'])",
                    "required": false,
                    "default": [
                        "json",
                        "txt",
                        "xlsx"
                    ],
                    "help": "Export formats (repeatable). Use '--format none' to suppress all exports.",
                    "hidden": false,
                    "is_flag": false,
                    "envvar": null
                },
                {
                    "name": "pdf_library",
                    "opts": [
                        "--engine",
                        "-e"
                    ],
                    "secondary_opts": [],
                    "type": "Choice(['pypdf', 'pymupdf', 'pdfium', 'auto', 'all'])",
                    "required": false,
                    "default": [
                        "pdfium"
                    ],
                    "help": "PDF parsing library backend choice.",
                    "hidden": false,
                    "is_flag": false,
                    "envvar": "PDF_ENGINE"
                },
                {
                    "name": "print_bool",
                    "opts": [
                        "--print"
                    ],
                    "secondary_opts": [
                        "--quiet"
                    ],
                    "type": "BOOL",
                    "required": false,
                    "default": true,
                    "help": "Print or do not print the analysis and validation report to console.",
                    "hidden": false,
